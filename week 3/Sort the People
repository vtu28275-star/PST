import java.util.*;

class Solution {
    public String[] sortPeople(String[] names, int[] heights) {
        
        int n = names.length;
        
        String[][] people = new String[n][2];

        // Store height and name
        for (int i = 0; i < n; i++) {
            people[i][0] = String.valueOf(heights[i]);
            people[i][1] = names[i];
        }

        // Sort by height descending
        Arrays.sort(people, (a, b) ->
            Integer.parseInt(b[0]) - Integer.parseInt(a[0])
        );

        // Store sorted names
        String[] result = new String[n];

        for (int i = 0; i < n; i++) {
            result[i] = people[i][1];
        }

        return result;
    }
}
